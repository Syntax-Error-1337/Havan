{
  "name": "haven-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:phone": "playwright test --project=phone",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "jsdom": "^31.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@swc/core@1.16.22": true,
    "fsevents@2.3.3": true
  }
}
