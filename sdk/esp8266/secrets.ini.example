; Copy to secrets.ini and fill in. It is gitignored, and it is the only place these live.
;
; `pio run -d sdk/esp8266 -t upload` picks it up automatically.
[esp12e]
build_flags =
    -D HAVEN_WIFI_SSID='"your-network"'
    -D HAVEN_WIFI_PASS='"your-password"'
    ; A pairing ticket from the app: Settings → Add device, or POST /v1/homes/{id}/pairing-tickets.
    ; It is single-use and expires in 5 minutes, so flash with it fresh. Leave it out once the
    ; device has a certificate — it only claims once.
    -D HAVEN_TICKET_VALUE='"hv1...."'
    ; Where the platform is, from the device's point of view.
    ; The machine's LAN address as `ipconfig getifaddr en0` reports it — not 127.0.0.1, which a
    ; device on the same Wi-Fi cannot reach. `make broker-tls` puts the same address in the
    ; broker's certificate, and both have to change together when DHCP moves the machine.
    ; Uncomment both to use the TLS listener that does not require a client certificate (8884).
    ; The device then authenticates at the MQTT layer with its serial and secret, which is a
    ; weaker credential than a certificate and the only one an ESP8266 has room for.
    ; -D HAVEN_MQTT_PORT=8884
    ; -D HAVEN_NO_CLIENT_CERT=1
    -D HAVEN_HOST=\"192.168.1.10\"
