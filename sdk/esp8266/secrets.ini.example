; Copy to secrets.ini and fill in. It is gitignored, and it is the only place these live.
;
; `pio run -d sdk/esp8266 -t upload` picks it up automatically.
[esp12e]
build_flags =
    -D HAVEN_WIFI_SSID='"your-network"'
    -D HAVEN_WIFI_PASS='"your-password"'
    ; A pairing ticket from the app: Settings → Add device, or POST /v1/homes/{id}/pairing-tickets.
    ; It is single-use and expires in 5 minutes, so flash with it fresh. Leave it out once the
    ; device has a certificate — it only claims once.
    -D HAVEN_TICKET_VALUE='"hv1...."'
    ; Where the platform is, from the device's point of view.
    -D HAVEN_HOST='"192.168.0.49"'
