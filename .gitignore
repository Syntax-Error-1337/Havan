# The deployment CA is generated per machine and must never be published: a committed CA key
# lets anyone with a clone sign a device certificate the broker trusts.
.haven/

# Graphify writes its extract here; it is a build artifact, not source.
graphify-out/

# The runtime test binary (the protocol one is already listed above).
sdk/c/tests/test_runtime

# Playwright artefacts (traces, screenshots, reports) — evidence for a failure, not source.
app/test-results/
app/playwright-report/
portal/test-results/
portal/playwright-report/
